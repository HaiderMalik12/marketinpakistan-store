# Copy to .env.local and fill in real values. .env.local is gitignored.

# WhatsApp number for customer support (international format, no + or leading 0)
NEXT_PUBLIC_WHATSAPP_NUMBER=923057252013

# Resend (https://resend.com) — free tier, used to email new orders to the business.
# Without a verified sending domain, Resend can only deliver to the email address
# on the Resend account itself (fine for owner notifications; customer confirmation
# emails won't actually arrive until marketinpakistan.shop is verified with Resend).
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_FROM_EMAIL=onboarding@resend.dev

# Neon Postgres — added automatically by the Neon integration in the Vercel dashboard
# (then `npx vercel env pull`). Use a separate Neon "dev" branch for local work.
DATABASE_URL=

# Admin panel (see specs/admin-panel-implementation-plan.md)
ADMIN_PASSWORD=
SESSION_SECRET=
CLOUDINARY_CLOUD_NAME=duwktiwnj
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
